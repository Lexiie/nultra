{
  "name": "nultra",
  "version": "0.1.0",
  "private": true,
  "description": "Nultra — Profit Intelligence Engine (PRD v3.0 MVP)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract:evidence": "mkdir -p nultra-mvp-prd/evidence && unzip -o nultra-mvp-prd/evidence/strike-mainnet.zip -d nultra-mvp-prd/evidence"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
